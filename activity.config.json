{
  "tools": {
    "hindsight_search_pages": { "action": "searchPages", "success": "completed" },
    "hindsight_list_pages": { "action": "listPages", "success": "completed" },
    "hindsight_read_page": { "action": "readPage", "success": "completed" },
    "hindsight_reflect": { "action": "reflectMemory", "success": "completed" },
    "hindsight_capture_initiative": { "action": "captureInitiative", "success": "submitted" },
    "hindsight_ingest_document": { "action": "ingestDocument", "success": "submitted" },
    "hindsight_sync_status": { "action": "syncStatus", "success": "completed" },
    "hindsight_diagnose": { "action": "diagnose", "success": "completed" }
  },
  "requestPathPattern": "(?:^|/)v1/[^/]+/banks(?:/|$)",
  "requests": [
    { "method": "POST", "path": "/memories/recall$", "action": "autoRecall", "success": "completed" },
    { "method": "POST", "path": "/reflect$", "action": "reflectMemory", "success": "completed" },
    { "method": "POST", "path": "/memories$", "action": "writeMemory", "success": "submitted" },
    { "method": "POST", "path": "/import$", "action": "syncMemory", "success": "submitted" },
    { "method": "GET", "path": "/operations(?:/[^/]+)?$", "action": "syncStatus", "success": "completed" },
    { "method": "GET", "path": "/(?:pages|knowledge-base)(?:/.*)?$", "action": "autoPages", "success": "completed" },
    { "method": "POST", "path": "/(?:pages|knowledge-base)/search$", "action": "searchPages", "success": "completed" },
    { "method": "*", "path": ".*", "action": "memoryService", "success": "completed" }
  ],
  "backgroundScripts": {
    "deepen.js": "syncMemory",
    "hindsight-seed.js": "syncMemory",
    "survey-supervisor.js": "surveyMemory"
  }
}
