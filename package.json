{
  "name": "dsh-hindsight-manager",
  "version": "0.4.0",
  "description": "Settings panel for the official Hindsight plugin in DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "activity.js",
    "activity.config.json",
    "cordis.patch.yml",
    "manager.config.json",
    "runtime-patches",
    "scripts/test-runtime.mjs",
    "tests/runtime",
    "tests/fixtures/api-contract-1.2.3.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:runtime": "node scripts/test-runtime.mjs",
    "check": "node --check index.js && node --check client.js && node --check activity.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moshangssh/dsh-hindsight-manager.git"
  },
  "bugs": { "url": "https://github.com/moshangssh/dsh-hindsight-manager/issues" },
  "keywords": ["dsh-plugin", "deepseek-harness", "hindsight", "memory"],
  "license": "MIT",
  "private": true
}
