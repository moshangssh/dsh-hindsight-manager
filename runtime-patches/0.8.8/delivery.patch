+  assert.equal(record.status, "skipped");
+  assert.equal(record.skipReason, "mode_none");
+  assert.equal(record.bodyPresent, false);
+  assert.equal(record.totalDurationMs, null);
+  assert.equal(
+    result.messages.find((message) => message.source.kind === "plugin:hindsight").source.hindsight
+      .bodyPresent,
+    false
+  );
+  assert.equal(
