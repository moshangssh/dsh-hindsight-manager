+  assert.equal(f.reports.at(-1).status, "failed");
+  assert.equal(f.reports.at(-1).stages[0].status, "not_found");
+  assert.equal(f.reports.at(-1).stages[0].result, null);
+  f.responses.recall = () => Response.json({ results: [] });
+  await f.prompt("second");
+  assert.equal(f.reports.at(-1).status, "empty");
+  assert.equal(f.reports.at(-1).stages[0].result.count, 0);
+});
+
+test("reflect fallback reports one logical chain with the final usable result", async (t) => {
+  const f = fixture(t, { autoInject: "reflect" });
+  f.prepare();
+  f.responses.reflect = () => Response.json({ error: "temporarily unavailable" }, { status: 503 });
+  await f.prompt();
+  const record = f.reports.at(-1);
+  assert.equal(record.status, "completed");
+  assert.equal(record.degraded, true);
+  assert.deepEqual(
+    record.stages.map(({ mode, status }) => [mode, status]),
+    [
+      ["reflect", "failed"],
+      ["pages", "empty"],
+      ["recall", "completed"],
+    ]
+  );
+  assert.equal(record.bodyPresent, true);
+});
