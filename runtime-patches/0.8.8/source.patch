+import { randomUUID } from "node:crypto";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createDshRuntime } from "./dsh";
+import { resolveConfig, type Config } from "./core/config";
+import { HindsightClient, HttpResponseError } from "./core/hindsight";
+import { resolveHostMemory } from "./core/host-client";
+import { RuntimeCore } from "./core/runtime";
+import { sessionCacheFile, writeSessionCache } from "./core/session-cache";
+import type { RecallRecord } from "./core/runtime-observation";
+
+vi.mock("./core/host-client", () => ({ resolveHostMemory: vi.fn() }));
+
+const configs = new Map<string, Config>();
+const records: RecallRecord[] = [];
+let runtime: ReturnType<typeof createDshRuntime>;
+let config: Config;
+
+function agent(root = "/workspace-a") {
+  return { session: { header: { id: randomUUID(), cwd: root }, snapshotEvents: () => [] } };
+}
+function enter(text: string) {
+  return async () => ({
+    kind: "enter" as const,
+    decisionExtra: "preserved",
+    messages: [
+      { role: "user" as const, content: [{ type: "text", text }], source: { kind: "user" } },
+    ],
+  });
+}
+function step(
+  a = agent(),
+  text = "remember the build decision",
+  turn = 1,
+  signal = new AbortController().signal
+) {
+  return runtime.hooks.preStep({ agent: a, signal, turn, step: 0 }, enter(text));
+}
+function response(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { "content-type": "application/json" },
+  });
+}
+function serve(retrieval: (url: string, init: RequestInit) => Response | Promise<Response>) {
+  const fetch = vi.fn(async (input: string | URL | Request, init?: RequestInit) => {
+    const url = String(input);
+    return url.endsWith("/pages/tree") ? response({ roots: [] }) : retrieval(url, init!);
+  });
+  vi.stubGlobal("fetch", fetch);
+  return fetch;
+}
+
+beforeEach(() => {
+  records.length = 0;
+  configs.clear();
+  config = resolveConfig({
+    apiUrl: "http://memory.internal",
+    bankId: "bank-a",
+    autoInject: "recall",
+    autoInjectEveryTurns: 1,
+    retainSessions: false,
+    autoUpdate: false,
+    autoSeed: false,
+    codebaseSurvey: false,
+    gitIngest: "none",
+  });
+  vi.spyOn(RuntimeCore.prototype, "seedIfCold").mockResolvedValue();
+  vi.mocked(resolveHostMemory).mockImplementation((_harness, root) => {
+    const cfg = configs.get(root) ?? config;
+    return {
+      cfg,
+      bankId: cfg.bankId!,
+      client: new HindsightClient({
+        apiUrl: cfg.apiUrl,
+        bank: cfg.bankId!,
+        recallOptions: cfg.recallOptions,
+      }),
+    };
+  });
+  runtime = createDshRuntime(({ record }) => records.push(record));
+});
+
+afterEach(async () => {
+  await runtime.dispose();
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+  vi.unstubAllEnvs();
