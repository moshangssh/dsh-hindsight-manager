+import { version } from "../../package.json";
+import type { AutoInject } from "./config";
+import {
+  HttpResponseError,
+  PagesUnavailableError,
+  RateLimitedError,
+  ReflectError,
+  type ResponseObserver,
+} from "./hindsight";
+
+export const OBSERVATION_PROTOCOL = 1;
+export const RUNTIME_SERVICE = "hindsightRuntime";
+export const OBSERVATION_EVENT = "hindsight/observation";
+
+/** This describes the executing module, independently of the on-disk installation declaration. */
+export function describeRuntime() {
+  return {
+    upstreamVersion: version,
+    patchSetVersion: "2",
+    capabilities: {
+      autoInjectEveryTurns: true,
+      runtimeInspection: true,
+      recallSummary: true,
+      injectionCorrelation: true,
+    },
+  };
+}
+
+export interface EffectiveMemory {
+  workspaceRoot: string;
+  bankId: string;
+  apiUrl: string;
+  autoInject: AutoInject;
+  autoInjectEveryTurns: number | null;
+  retainSessions: boolean;
+  injectTimeoutMs: number;
+  recallOptions: { types: unknown; budget: unknown; max_tokens: unknown };
+}
+
+export interface RuntimeInspection {
+  protocolVersion: 1;
+  sessionId: string | null;
+  status:
+    | "session_not_active"
+    | "excluded_subagent"
+    | "workspace_uninitialized"
+    | "disabled"
+    | "ready";
+  hooksDisabled: boolean;
+  runtime: ReturnType<typeof describeRuntime>;
+  effective: EffectiveMemory | null;
+}
+
+type RetrievalMode = Exclude<AutoInject, "none">;
+export type RecallSkipReason =
+  | "mode_none"
+  | "deferred_new_bank"
+  | "cached_decision"
+  | "hooks_disabled"
+  | "workspace_disabled"
+  | "excluded_subagent"
+  | "no_user_text";
+export interface RecallStage {
+  mode: RetrievalMode;
+  status: "completed" | "empty" | "not_found" | "unavailable" | "failed" | "cancelled";
+  durationMs: number;
+  httpStatus: number | null;
+  errorKind: string | null;
+  result: { unit: "memories" | "pages" | "characters"; count: number } | null;
+}
+
+export interface RecallRecord {
+  protocolVersion: 1;
+  turn: null;
+  ownerTurn: number;
+  recallId: string;
+  inspection: RuntimeInspection;
+  requestedMode: AutoInject | null;
+  status: "running" | "completed" | "empty" | "failed" | "cancelled" | "skipped";
+  interruption: { phase: "preparation"; kind: "cancelled" | "failed" } | null;
+  degraded: boolean;
+  skipReason: RecallSkipReason | null;
+  totalDurationMs: number | null;
+  stages: RecallStage[];
+  bodyPresent: boolean | null;
+}
+
+export interface QueryScope {
+  sessionId: string;
+  ownerTurn: number;
+  recallId: string;
+}
+
+/** One collector per prompt. Only the adapter emits events; the shared core updates this value. */
+export class RecallObservation {
+  readonly record: RecallRecord;
+  private startedAt: number | null = null;
+  private bodyFinished = false;
+
+  constructor(
+    inspection: RuntimeInspection,
+    readonly scope: QueryScope,
+    private readonly signal: AbortSignal,
+    private readonly scoped: (callback: () => Promise<void>) => Promise<void>
+  ) {
+    this.record = {
+      protocolVersion: OBSERVATION_PROTOCOL,
+      turn: null,
+      ownerTurn: scope.ownerTurn,
+      recallId: scope.recallId,
+      inspection,
+      requestedMode: inspection.effective?.autoInject ?? null,
+      status: "running",
+      interruption: null,
+      degraded: false,
+      skipReason: null,
+      totalDurationMs: null,
+      stages: [],
+      bodyPresent: null,
+    };
+  }
+
+  skip(reason: RecallSkipReason): void {
+    this.record.status = "skipped";
+    this.record.skipReason = reason;
+  }
+
+  /** The scope ends before roster fetching; its result must survive later preparation failures. */
+  async body(callback: () => Promise<void>): Promise<void> {
+    try {
+      await this.scoped(callback);
+      this.bodyFinished = true;
+    } finally {
+      if (this.startedAt !== null) {
+        this.record.totalDurationMs = performance.now() - this.startedAt;
+        const stages = this.record.stages;
+        this.record.status = stages.some((s) => s.status === "cancelled")
+          ? "cancelled"
+          : stages.some((s) => s.status === "completed")
+            ? "completed"
+            : stages.some((s) => s.status !== "empty")
+              ? "failed"
+              : "empty";
+        this.record.degraded =
+          this.record.status === "completed" && stages.some((s) => s.status === "failed");
+      }
+    }
+  }
+
+  async stage<T>(
+    mode: RetrievalMode,
+    call: (onResponse?: ResponseObserver) => Promise<T>,
+    count: (value: T) => number
+  ): Promise<T> {
+    const start = performance.now();
+    this.startedAt ??= start;
+    let httpStatus: number | null = null;
+    const stage: RecallStage = {
+      mode,
+      status: "failed",
+      durationMs: 0,
+      httpStatus: null,
+      errorKind: null,
+      result: null,
+    };
+    try {
+      const value = await call((response) => {
+        httpStatus = response.status;
+      });
+      this.signal.throwIfAborted();
+      stage.httpStatus = httpStatus;
+      if (httpStatus === 404) {
+        stage.status = "not_found";
+        stage.errorKind = "http";
+      } else {
+        const amount = count(value);
+        stage.status = amount > 0 ? "completed" : "empty";
+        stage.result = {
+          unit: mode === "recall" ? "memories" : mode === "pages" ? "pages" : "characters",
+          count: amount,
+        };
+      }
+      return value;
+    } catch (error) {
+      // A prior response can precede a replay transport failure or body timeout. Only an error
+      // whose type proves a terminal HTTP response may reuse its status.
+      if (this.signal.aborted) {
+        stage.status = "cancelled";
+        stage.errorKind = "cancelled";
+      } else if (error instanceof PagesUnavailableError) {
+        stage.status = "unavailable";
+        stage.httpStatus = httpStatus;
+        stage.errorKind = "pages_unavailable";
+      } else if (error instanceof RateLimitedError) {
+        stage.httpStatus = 429;
+        stage.errorKind = "rate_limited";
+      } else if (error instanceof HttpResponseError || error instanceof ReflectError) {
+        stage.httpStatus = error.status ?? null;
+        stage.errorKind = error instanceof ReflectError && error.timedOut ? "timeout" : "http";
+      } else if (error instanceof Error) {
+        // TypeError may come from fetch, a broken response body, or parsed data with an
+        // unexpected shape. Its name alone cannot distinguish network from response failures.
+        stage.errorKind =
+          error.name === "TimeoutError" || error.name === "AbortError"
+            ? "timeout"
+            : error instanceof SyntaxError
+              ? "invalid_response"
+              : error.name;
+      } else {
+        stage.errorKind = "unknown";
+      }
+      throw error;
+    } finally {
+      stage.durationMs = performance.now() - start;
+      this.record.stages.push(stage);
+    }
+  }
+
+  interrupted(): void {
+    const kind = this.signal.aborted ? "cancelled" : "failed";
+    if (this.bodyFinished) this.record.interruption = { phase: "preparation", kind };
+    else this.record.status = kind;
+  }
+
+  snapshot(): RecallRecord {
+    return structuredClone(this.record);
+  }
+}
