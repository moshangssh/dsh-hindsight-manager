+test("reflect fallback reports one logical chain with the final usable result", async (t) => {
+  const f = fixture(t, { autoInject: "reflect" });
+  f.prepare();
+  f.responses.reflect = () => Response.json({ error: "temporarily unavailable" }, { status: 503 });
+  await f.prompt();
+  const record = f.reports.at(-1);
+  assert.equal(record.status, "completed");
+  assert.equal(record.degraded, true);
+  assert.deepEqual(
+    record.stages.map(({ mode, status }) => [mode, status]),
+    [
+      ["reflect", "failed"],
+      ["pages", "empty"],
+      ["recall", "completed"],
+    ]
+  );
+  assert.equal(record.bodyPresent, true);
+});
