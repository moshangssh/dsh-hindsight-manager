+    assert.equal(url.origin, "http://memory.invalid");
+    requests.push({
+      path: url.pathname,
+      scope: runtime.queryScope(),
+      body: init.body ? JSON.parse(init.body) : null,
+    });
+    if (url.pathname.endsWith("/memories/recall")) return responses.recall(init);
+    if (url.pathname.endsWith("/pages/search")) return responses.pages(init);
+    if (url.pathname.endsWith("/reflect")) return responses.reflect(init);
+    if (url.pathname.endsWith("/pages/tree")) return responses.tree(init);
+    unexpected.push(url.pathname);
+    throw new Error(`Unexpected request: ${url.pathname}`);
+  };
+  const id = randomUUID();
+  const events = [];
+  const agent = {
+    session: { header: { id, cwd: workspace, origin: "user" }, snapshotEvents: () => events },
+  };
+  let turn = 0;
+  t.after(async () => {
+    await runtime.dispose();
+    rmSync(join(tmpdir(), "hindsight-dsh", `${id}.json`), { force: true });
+    assert.deepEqual(unexpected, []);
+  });
+  return {
+    runtime,
+    agent,
+    reports,
+    requests,
+    responses,
+    prepare() {
+      runtime.workspaceFor(workspace).seeded = Promise.resolve();
+    },
+    async prompt(text = "a question", signal = new AbortController().signal) {
+      const decision = {
+        kind: "enter",
+        startsRequestSeries: true,
+        messages: [
+          {
+            id: randomUUID(),
+            role: "user",
+            source: { kind: "user" },
+            content: [{ type: "text", text }],
+          },
+        ],
+      };
+      const result = await runtime.hooks.preStep(
+        { agent, turn: ++turn, signal },
+        async () => decision
+      );
+      for (const message of result.messages) events.push({ type: "user/message", data: message });
+      return result;
+    },
+  };
+}
