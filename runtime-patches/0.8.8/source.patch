+const callerCancellation = new AsyncLocalStorage<AbortSignal | undefined>();
+
+export function throwIfCallerAborted(): void {
+  callerCancellation.getStore()?.throwIfAborted();
+}
+
+export function withCallerSignal<T>(
+  signal: AbortSignal | undefined,
+  callback: () => Promise<T>
+): Promise<T> {
+  return callerCancellation.run(signal, async () => {
+    signal?.throwIfAborted();
+    try {
+      const result = await callback();
+      signal?.throwIfAborted();
+      return result;
+    } catch (error) {
+      signal?.throwIfAborted();
+      throw error;
+    }
+  });
+}
