+test("disabling recall still permits the first-turn directory without claiming memory content", async (t) => {
+  const f = fixture(t, { autoInject: "none" });
+  f.prepare();
+  const result = await f.prompt();
+  const record = f.reports.at(-1);
+  assert.equal(record.status, "skipped");
+  assert.equal(record.skipReason, "mode_none");
+  assert.equal(record.bodyPresent, false);
+  assert.equal(record.totalDurationMs, null);
+  assert.equal(
+    result.messages.find((message) => message.source.kind === "plugin:hindsight").source.hindsight
+      .bodyPresent,
+    false
+  );
+  assert.equal(
+    f.requests.some(({ path }) => path.endsWith("/memories/recall")),
+    false
+  );
