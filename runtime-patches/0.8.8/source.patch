+test("recall reports usable results and correlates only its body requests and prepared message", async (t) => {
+  const f = fixture(t);
+  f.prepare();
+  const result = await f.prompt();
+  const record = f.reports.at(-1);
+  assert.equal(record.status, "completed");
+  assert.equal(record.ownerTurn, 1);
+  assert.deepEqual(record.stages[0].result, { unit: "memories", count: 1 });
+  assert.equal(record.stages[0].httpStatus, 200);
+  assert.equal(record.bodyPresent, true);
+  assert.ok(record.totalDurationMs >= 0);
+  const message = result.messages.find((message) => message.source.kind === "plugin:hindsight");
+  assert.equal(message.source.hindsight.recallId, record.recallId);
+  assert.equal(message.source.hindsight.bodyPresent, true);
+  assert.equal(result.startsRequestSeries, true);
+  assert.ok(!JSON.stringify(f.reports).includes("remembered fact"));
+  assert.equal(
+    f.requests.find(({ path }) => path.endsWith("/memories/recall")).scope.recallId,
+    record.recallId
+  );
+  assert.equal(f.requests.find(({ path }) => path.endsWith("/pages/tree")).scope, undefined);
+  const count = f.reports.length;
+  const continuation = { kind: "enter", messages: [] };
+  await f.runtime.hooks.preStep(
+    { agent: f.agent, turn: 1, signal: new AbortController().signal },
+    async () => continuation
+  );
+  assert.equal(f.reports.length, count);
+});
