+async function loadRuntime(overrides = {}) {
+  const bundle = await readFile(bundlePath, 'utf8');
+  const section = (start, end) => {
+    const from = bundle.indexOf(start);
+    return bundle.slice(from, bundle.indexOf(end, from));
