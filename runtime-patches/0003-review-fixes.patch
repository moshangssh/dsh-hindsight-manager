+function addExchange(user, assistant) {
+  agent.session.events.push(
+    { type: 'user/message', data: { source: { kind: 'user' }, content: [{ type: 'text', text: user }] } },
+    { type: 'assistant/message', data: { message: { content: [{ type: 'text', text: assistant }] } } },
