+    ]);
+    assert.deepEqual(await admittedNames(tools, agentFor(process.cwd())), []);
+    const subagent = agentFor(workspace);
+    subagent.session.header.origin = 'subagent';
+    assert.deepEqual(await admittedNames(tools, subagent), []);
+    await plugin.dispose();
+    assert.deepEqual(tools.schemas(), []);
+    plugin = await ctx.plugin(adapter);
+    assert.deepEqual(tools.schemas().map(({ name }) => name), expectedNames);
+  } finally { await plugin.dispose(); }
+});
+
+test('session-bound definitions follow refresh and cannot execute for disabled workspaces or subagents', async () => {
+  configure({});
+  const runtime = makeRuntime();
+  assert.deepEqual(runtime.toolDefinitions(workspace), [], 'explicit disabled root stays disabled');
+  const definitions = runtime.toolDefinitions();
+  const tool = definitions.find(({ name }) => name === 'hindsight_list_pages');
+  assert.ok(tool, 'native schema registration is independent of enabled workspaces');
+  const agent = agentFor(workspace);
+  const signal = new AbortController().signal;
+  await assert.rejects(tool.execute({}, { agent, signal }), /disabled/);
+  await assert.rejects(tool.execute({}, { signal }), /disabled/, 'unbound definitions require a session workspace');
+  configure({ [workspace]: 'enabled-bank' });
+  await runtime.refresh();
+  await tool.execute({}, { agent, signal });
+  assert.match(requests.at(-1), /\/banks\/enabled-bank\//);
+  configure({ [workspace]: 'changed-bank' });
+  await runtime.refresh();
+  await tool.execute({}, { agent, signal });
+  assert.match(requests.at(-1), /\/banks\/changed-bank\//);
+  const subagent = agentFor(workspace);
+  subagent.session.header.origin = 'subagent';
+  await assert.rejects(tool.execute({}, { agent: subagent, signal }), /disabled/);
+  configure({});
+  await runtime.refresh();
+  await assert.rejects(tool.execute({}, { agent, signal }), /disabled/);
+  assert.equal(requests.length, 2);
+});
